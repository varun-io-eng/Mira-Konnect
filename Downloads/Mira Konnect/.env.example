# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mira_konnect?schema=public"

# Public site URL (canonical, no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4
NEXT_PUBLIC_GA_ID=""

# Object storage (resumes — private bucket)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email (SMTP — server only; required for live contact + job application notifications)
# Must match SMTP_USER on Hostinger (same mailbox you log in with)
EMAIL_FROM="Mira Konnect <info@mirakonnect.com>"
NOTIFICATION_INBOX="info@mirakonnect.com"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@mirakonnect.com"
SMTP_PASSWORD=""
# If port 465 times out on your network, use SMTP_PORT="587" and SMTP_SECURE="false"
# In Hostinger hPanel, enable Email DKIM + SPF for mirakonnect.com so mail is not marked as spam.

# Auth (to be configured in auth phase)
# Min 16 characters — required for login/register sessions
AUTH_SECRET="change-me-to-a-long-random-string"

# Job publisher portal (/admin/login → /admin/publish)
ADMIN_PUBLISH_EMAIL="admin@gmail.com"
ADMIN_PUBLISH_PASSWORD="MiraKonnectPublish2026!"
